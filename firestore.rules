rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validAppointment(d) {
      return d.keys().hasOnly([
          'treatments', 'totalPrice', 'durationMin', 'date', 'startMinutes', 'startTime',
          'staffId', 'staffName', 'customer', 'notes', 'locale', 'status', 'createdAt'
        ])
        && d.staffId is string && d.staffId.size() > 0 && d.staffId.size() <= 40
        && d.staffName is string && d.staffName.size() <= 100
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.treatments is list && d.treatments.size() > 0 && d.treatments.size() <= 20
        && d.totalPrice is int && d.totalPrice >= 0
        && d.durationMin is int && d.durationMin > 0 && d.durationMin <= 600
        && d.startMinutes is int && d.startMinutes >= 0 && d.startMinutes < 1440
        && d.startTime is string && d.startTime.size() == 5
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.customer.keys().hasOnly(['name', 'phone', 'email'])
        && d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() <= 100
        && d.customer.phone is string && d.customer.phone.size() >= 7 && d.customer.phone.size() <= 30
        && d.customer.email is string && d.customer.email.size() <= 200
        && d.notes is string && d.notes.size() <= 1000
        && d.locale is string && d.locale.size() <= 10;
    }

    // Full bookings with personal data: clients may only create them.
    // Read/manage them in the Firebase console (or a future authenticated admin panel).
    match /appointments/{id} {
      allow create: if validAppointment(request.resource.data);
      allow read, update, delete: if false;
    }

    // Per-specialist time ranges (no personal data) used to compute availability.
    // Id is "{staffId}_{date}_{start}" and docs can't be overwritten, so the same specialist
    // can't get two bookings with the same start time (the second batch fails).
    // Must be written in the same batch as its appointment.
    match /busySlots/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['appointmentId', 'staffId', 'date', 'start', 'end'])
        && request.resource.data.appointmentId is string
        && id == request.resource.data.staffId + '_' + request.resource.data.date + '_' + string(request.resource.data.start)
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && matchesAppointment(
             getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data,
             request.resource.data);
      allow update, delete: if false;
    }

    function matchesAppointment(appt, slot) {
      return appt.staffId == slot.staffId
        && appt.date == slot.date
        && appt.startMinutes == slot.start
        && slot.end == slot.start + appt.durationMin;
    }
  }
}
